{
  "name": "backend-twk-admin",
  "version": "1.0.0",
  "description": "The Woven Cloud Kitchen - Admin Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed": "ts-node-dev --transpile-only src/infrastructure/database/seed/index.ts"
  },
  "keywords": [
    "kitchen",
    "admin",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "inversify": "^6.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.3.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "swagger-jsdoc": "^6.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3"
  }
}
