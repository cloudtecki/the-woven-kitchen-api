# Application
NODE_ENV=development
PORT=3000

# Database (MongoDB)
MONGODB_URI="mongodb://localhost:27017/thewovencloudkitchen"
DB_NAME=thewovencloudkitchen

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# API
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=debug

# Seed
SEED_ADMIN_EMAIL=admin@thewovencloudkitchen.com
SEED_ADMIN_NAME=System Administrator
