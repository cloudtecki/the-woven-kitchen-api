# Application
NODE_ENV=development
PORT=3000

# Database (MongoDB)
MONGODB_URI="mongodb://localhost:27017/thewovencloudkitchen"
DB_NAME=thewovencloudkitchen

# API
API_PREFIX=/api

# Logging
LOG_LEVEL=info

# Auth (JWT) — never commit a real secret
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# Initial Admin (used by `npm run seed:admin`) — placeholders only, do not commit real credentials
ADMIN_NAME=Root Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_PHONE=9876543210
